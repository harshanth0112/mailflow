# ==========================================
# MAILFLOW SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Application Origins & Base URLs
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# MongoDB Connection URI (Leave empty to use in-memory dev store fallback or provide MongoDB URI)
MONGODB_URI=

# Authentication / JWT
JWT_ACCESS_SECRET=mailflow-dev-access-secret-32-chars-long-key!
JWT_REFRESH_SECRET=mailflow-dev-refresh-secret-32-chars-long-key!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Transactional Email (Phase 2)
# When SMTP_USER and SMTP_PASS are empty, transactional emails log to console in dev mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@mailflow.io
SMTP_FROM_NAME="MailFlow Team"

# OAuth Providers (Optional in dev, activate when OAuth credentials are provided)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/github/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/microsoft/callback

# ==========================================
# REDIS / BULLMQ QUEUE CONFIGURATION (Phase 9)
# ==========================================
# Provide REDIS_URL (takes precedence) OR individual host/port/password values.
# When both are absent the application starts in degraded mode and queued
# campaigns are rejected with a clear error rather than silently dropped.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# TOKEN ENCRYPTION KEY (Phase 7+)
# ==========================================
# 64-character hex string used for AES-256-GCM encryption of OAuth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
