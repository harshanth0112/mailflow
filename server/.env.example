# Local development only. Render production values belong in the dashboard.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Leave MONGODB_URI empty to use the local in-memory development fallback.
MONGODB_URI=

# Optional locally. When omitted, development-only ephemeral keys are generated.
# For persistent local OAuth-token encryption, set ENCRYPTION_KEY to 64 hex characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cross-site production cookies default to SameSite=None; Secure.
# Local development uses Lax. Do not set None outside HTTPS production.
COOKIE_SAME_SITE=lax

# Transactional email provider: console previews are local-only.
EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDLIBERTY_API_KEY=
SENDLIBERTY_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="MailFlow Team"

# Campaigns use connected Gmail/Outlook mailboxes unless explicitly configured for Sendliberty.
CAMPAIGN_EMAIL_PROVIDER=mailbox

# Optional OAuth credentials for Google Single Sign-On (SSO) and mailbox integration.
# Callback URL for Google OAuth: ${API_BASE_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/github/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/microsoft/callback

# Keep disabled unless a Redis TCP/TLS endpoint and healthy worker are deployed.
QUEUE_FEATURES_ENABLED=false
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
