# ==========================================
# MAILFLOW SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# e.g. mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mailflow?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------
# PLACEHOLDERS FOR FUTURE PHASES (DO NOT FILL IN PHASE 1)
# ------------------------------------------

# Authentication / JWT (Phase 2)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP / Email Service (Phase 2+)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="MailFlow Team"

# Redis / BullMQ (Phase 7+)
REDIS_URL=

# AI Assistant Provider API Key (Phase 12)
AI_API_KEY=
